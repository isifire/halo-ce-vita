+static char *glsl_skip_space_and_comments(char *text) {
+	for (;;) {
+		while (*text == ' ' || *text == '\t' || *text == '\r' || *text == '\n')
+			text++;
+		if (text[0] == '/' && text[1] == '/') {
+			text += 2;
+			while (*text && *text != '\n')
+				text++;
+			continue;
+		}
+		if (text[0] == '/' && text[1] == '*') {
+			char *comment_end = strstr(text + 2, "*/");
+			if (!comment_end)
+				return text + strlen(text);
+			text = comment_end + 2;
+			continue;
+		}
+		return text;
+	}
+}
+
+static char *glsl_find_statement_boundary(char *text) {
+	unsigned int parentheses = 0;
+	unsigned int brackets = 0;
+
+	while (*text) {
+		if (text[0] == '/' && (text[1] == '/' || text[1] == '*')) {
+			text = glsl_skip_space_and_comments(text);
+			if (!*text)
+				return NULL;
+			continue;
+		}
+		if (*text == '(')
+			parentheses++;
+		else if (*text == ')' && parentheses)
+			parentheses--;
+		else if (*text == '[')
+			brackets++;
+		else if (*text == ']' && brackets)
+			brackets--;
+		else if (!parentheses && !brackets &&
+			(*text == ';' || *text == '{' || *text == '}'))
+			return text;
+		text++;
+	}
+	return NULL;
+}
+
+static char *glsl_find_matching_brace(char *open_brace) {
+	unsigned int depth = 0;
+	char *text = open_brace;
+
+	while (*text) {
+		if (text[0] == '/' && (text[1] == '/' || text[1] == '*')) {
+			text = glsl_skip_space_and_comments(text);
+			if (!*text)
+				return NULL;
+			continue;
+		}
+		if (*text == '{')
+			depth++;
+		else if (*text == '}' && depth && --depth == 0)
+			return text;
+		text++;
+	}
+	return NULL;
+}
+
+static GLboolean glsl_starts_global_type(char *text) {
+	static const char *types[] = {
+		"float", "int", "vec", "ivec", "mat", "const",
+		"lowp", "mediump", "highp"
+	};
+	static const size_t lengths[] = { 5, 3, 3, 4, 3, 5, 4, 7, 5 };
+	unsigned int i;
+
+	for (i = 0; i < sizeof(types) / sizeof(types[0]); i++) {
+		if (!strncmp(text, types[i], lengths[i])) {
+			char next = text[lengths[i]];
+			if (next == ' ' || next == '\t' || next == '\r' || next == '\n')
+				return GL_TRUE;
+			if ((!strcmp(types[i], "vec") || !strcmp(types[i], "ivec") ||
+				!strcmp(types[i], "mat")) && next >= '2' && next <= '4')
+				return GL_TRUE;
+		}
+	}
+	return GL_FALSE;
+}
