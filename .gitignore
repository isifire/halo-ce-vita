.vs/
.vscode/
*.suo
*.user
*.userosv
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
*.bak
*.orig
.directory
.clangd/

# Language and tool caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
*.egg-info/
/.venv/
/venv/
/env/
/.env/
.cache/

# CMake, Ninja, and compiler output
build/
build-*/
*-build/
cmake-build-*/
projects/
.ninja_*
build.ninja
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
